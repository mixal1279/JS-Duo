# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Supabase cloud accounts and cross-device progress sync.
# Create a project at https://supabase.com, then copy these from Project Settings -> API.
# Use the public anon/publishable key only. NEVER put a service_role or secret key in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
