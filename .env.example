# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Supabase cloud accounts and cross-device progress sync.
# Configure matching GitHub Actions repository secrets for APK builds.
# Use only the public anon/publishable key here; never use service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public web URL used by Supabase password recovery emails
VITE_APP_URL=https://mixal1279.github.io/JS-Duo/
