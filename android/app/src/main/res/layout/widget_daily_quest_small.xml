<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp"
    android:background="@drawable/widget_bg">

    <ImageView
        android:id="@+id/widget_status_icon"
        android:layout_width="74dp"
        android:layout_height="74dp"
        android:src="@drawable/cybercat_happy"
        android:scaleType="fitCenter"
        android:contentDescription="Nastrój cyberkota" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="3dp">
        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:src="@drawable/ic_widget_flame"
            android:contentDescription="Passa" />
        <TextView
            android:id="@+id/widget_streak_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="0"
            android:textColor="#FF9A45"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_xp_count"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:text="0/30 XP" />
    <ProgressBar
        android:id="@+id/widget_xp_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:max="30"
        android:progress="0" />
    <TextView
        android:id="@+id/widget_status_title"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:text="" />
    <TextView
        android:id="@+id/widget_status_desc"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:text="" />
    <TextView
        android:id="@+id/widget_action_button"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:text="" />
    <ImageView
        android:id="@+id/widget_mascot_logo"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:src="@drawable/cybercat_happy" />
</LinearLayout>