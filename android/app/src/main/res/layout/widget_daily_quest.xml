<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header: logo + brand -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="JS Duo"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Stats row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Streak Pill -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_stat_pill_bg"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_widget_flame"
                android:contentDescription="Passa" />

            <TextView
                android:id="@+id/widget_streak_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="0"
                android:textColor="#FF9600"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Daily XP Pill -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.35"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_stat_pill_bg"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/widget_xp_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/30 XP"
                android:textColor="#58CC02"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hearts Pill -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_stat_pill_bg"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_widget_heart"
                android:contentDescription="Serca" />

            <TextView
                android:id="@+id/widget_hearts_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="5/5"
                android:textColor="#FF4B4B"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_xp_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:progress="0"
        android:max="30"
        android:progressTint="#58CC02"
        android:progressBackgroundTint="#2A373F" />

    <!-- Motivational Content in Middle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp">

        <ImageView
            android:id="@+id/widget_status_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_widget_flame"
            android:contentDescription="Status" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_status_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zrób codzienną lekcję!"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_status_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Utrzymaj swoją passę i zdobądź +25 XP dzisiaj."
                android:textColor="#9EACB4"
                android:textSize="11sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- CTA Button to directly jump into practice -->
    <TextView
        android:id="@+id/widget_action_button"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/widget_button_bg"
        android:gravity="center"
        android:text="Rozpocznij lekcję teraz ⚡"
        android:textColor="#000000"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
